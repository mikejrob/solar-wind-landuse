  <mdb:resourceLineage>
    <mrl:LI_Lineage>
      <mrl:statement>
        <gco:CharacterString>
The Hawaii CDL uses Google Earth Engine to produce land cover classifications. ERDAS Imagine is used for pre- and post-processing of raster data. ESRI ArcGIS is used to prepare vector data.
        </gco:CharacterString>
      </mrl:statement>

      <!-- Sources -->
      <mrl:source>
        <mrl:LI_Source>
          <mrl:description><gco:CharacterString>Machine-learning generated satellite embeddings used as ancillary inputs supporting the classification process.</gco:CharacterString></mrl:description>
          <mrl:sourceCitation>
            <cit:CI_Citation>
              <cit:title><gco:CharacterString>AlphaEarth Foundations Satellite Embedding</gco:CharacterString></cit:title>
              <cit:publisher><cit:CI_Organisation><cit:name><gco:CharacterString>Google DeepMind</gco:CharacterString></cit:name></cit:CI_Organisation></cit:publisher>
              <cit:onlineResource><cit:CI_OnlineResource><cit:linkage><gco:CharacterString>https://deepmind.google/</gco:CharacterString></cit:linkage></cit:CI_OnlineResource></cit:onlineResource>
            </cit:CI_Citation>
          </mrl:sourceCitation>
          <mrl:sourceScaleDenominator><gco:Integer>10000</gco:Integer></mrl:sourceScaleDenominator>
          <mrl:sourceExtent>
            <gex:EX_Extent>
              <gex:temporalElement>
                <gex:EX_TemporalExtent>
                  <gex:extent>
                    <gml:TimePeriod gml:id="tp-src-ae">
                      <gml:beginPosition>2023-01-01</gml:beginPosition>
                      <gml:endPosition>2024-12-31</gml:endPosition>
                    </gml:TimePeriod>
                  </gex:extent>
                </gex:EX_TemporalExtent>
              </gex:temporalElement>
            </gex:EX_Extent>
          </mrl:sourceExtent>
        </mrl:LI_Source>
      </mrl:source>

      <mrl:source>
