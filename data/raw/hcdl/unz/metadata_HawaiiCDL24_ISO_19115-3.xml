              <cit:onlineResource><cit:CI_OnlineResource><cit:linkage><gco:CharacterString>https://www.fs.usda.gov/detail/r5/communityforests/?cid=fseprd1009698</gco:CharacterString></cit:linkage></cit:CI_OnlineResource></cit:onlineResource>
